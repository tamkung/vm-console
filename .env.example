# Default Proxmox Host URL (Optional fallback if not provided in login)
PROXMOX_URL=https://192.168.1.1:8006

# Security: Allow self-signed certificates
# Set to '0' for development environments with self-signed certs.
# Remove or set to '1' for production environments with valid SSL.
NODE_TLS_REJECT_UNAUTHORIZED=0

# JWT & Session Secret Key (Used for VM Sharing and RDP Token Encryption)
JWT_SECRET=your-secret-key-at-least-32-chars
RDP_ENCRYPTION_KEY=your-secret-key-at-least-32-chars

# Native Guacamole Daemon (guacd) Configuration
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
